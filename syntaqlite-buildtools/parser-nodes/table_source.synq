enum JoinType {
  COMMA INNER LEFT RIGHT FULL CROSS
  NATURAL_INNER NATURAL_LEFT NATURAL_RIGHT NATURAL_FULL NATURAL_CROSS
}

node TableRef {
  table_name: inline SyntaqliteTextSpan
  schema: inline SyntaqliteTextSpan
  has_parens: inline Bool
  alias: index Name
  args: index ExprList

  semantic { source_ref(kind: table, name: table_name, alias: alias) }

  fmt {
    if_span(schema) { span(schema) "." }
    span(table_name)
    if_set(args) {
      group { "(" nest { softline child(args) } softline ")" }
    } else {
      if_flag(has_parens) { "()" }
    }
    if_set(alias) { space "AS" space child(alias) }
  }
}

node SubqueryTableSource {
  select: index Select
  alias: index Name

  semantic { scoped_source(body: select, alias: alias) }

  fmt {
    group { "(" nest { softline child(select) } softline ")" }
    if_set(alias) { space "AS" space child(alias) }
  }
}

node JoinClause {
  join_type: inline JoinType
  left: index TableSource
  right: index TableSource
  on_expr: index Expr
  using_columns: index ExprList

  fmt {
    switch(join_type) {
      COMMA {
        child(left) "," space child(right)
        if_set(on_expr) { hardline "ON" space child(on_expr) }
        if_set(using_columns) { group { space "USING" space "(" nest { softline child(using_columns) } softline ")" } }
      }
      default {
        child(left) hardline
        group {
          switch(join_type) {
            INNER         { "JOIN" }
            LEFT          { "LEFT" "JOIN" }
            RIGHT         { "RIGHT" "JOIN" }
            FULL          { "FULL" "JOIN" }
            CROSS         { "CROSS" "JOIN" }
            NATURAL_INNER { "NATURAL" "JOIN" }
            NATURAL_LEFT  { "NATURAL" "LEFT" "JOIN" }
            NATURAL_RIGHT { "NATURAL" "RIGHT" "JOIN" }
            NATURAL_FULL  { "NATURAL" "FULL" "JOIN" }
            NATURAL_CROSS { "NATURAL" "CROSS" "JOIN" }
            COMMA         { "," }
          }
          space child(right)
          if_set(on_expr) { nest { line "ON" space child(on_expr) } }
          if_set(using_columns) { group { space "USING" space "(" nest { softline child(using_columns) } softline ")" } }
        }
      }
    }
  }
}

node JoinPrefix {
  source: index TableSource
  join_type: inline JoinType

  fmt { child(source) }
}

abstract TableSource {
  TableRef SubqueryTableSource JoinClause JoinPrefix
}
