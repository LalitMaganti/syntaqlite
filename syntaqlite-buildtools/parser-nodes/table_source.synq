enum JoinType {
  COMMA INNER LEFT RIGHT FULL CROSS
  NATURAL_INNER NATURAL_LEFT NATURAL_RIGHT NATURAL_FULL NATURAL_CROSS
}

enum JoinModifierKind { NATURAL LEFT OUTER RIGHT FULL INNER CROSS }

node JoinModifier {
  kind: inline JoinModifierKind

  fmt {
    enum_display(kind, {
      NATURAL="NATURAL" LEFT="LEFT" OUTER="OUTER" RIGHT="RIGHT"
      FULL="FULL" INNER="INNER" CROSS="CROSS"
    })
  }
}

list JoinModifierList {
  JoinModifier
  fmt { for_each(sep: space) { child(_item) } }
}

node TableRef {
  table_name: inline SyntaqliteTextSpan
  schema: inline SyntaqliteTextSpan
  has_parens: inline Bool
  alias: index Name
  alias_as: inline Bool
  args: index ExprList
  index_hint: inline IndexHint
  index_name: inline SyntaqliteTextSpan

  semantic { source_ref(kind: table, name: table_name, alias: alias) }

  fmt {
    if_span(schema) { span(schema) "." }
    span(table_name)
    if_set(args) {
      group { "(" nest { softline child(args) } softline ")" }
    } else {
      if_flag(has_parens) { "(" ")" }
    }
    if_set(alias) {
      if_flag(alias_as) { space "AS" space child(alias) } else { space child(alias) }
    }
    switch(index_hint) {
      INDEXED { space "INDEXED" "BY" space span(index_name) }
      NOT_INDEXED { space "NOT" "INDEXED" }
    }
  }
}

node SubqueryTableSource {
  select: index Select
  alias: index Name
  alias_as: inline Bool

  semantic { scoped_source(body: select, alias: alias) }

  fmt {
    group { "(" nest { softline child(select) } softline ")" }
    if_set(alias) {
      if_flag(alias_as) { space "AS" space child(alias) } else { space child(alias) }
    }
  }
}

// Structurally required once the term has an alias or ON/USING.
node ParenTableSource {
  source: index TableSource
  alias: index Name
  alias_as: inline Bool

  fmt {
    group { "(" nest { softline child(source) } softline ")" }
    if_set(alias) {
      if_flag(alias_as) { space "AS" space child(alias) } else { space child(alias) }
    }
  }
}

node JoinClause {
  join_type: inline JoinType
  modifiers: index JoinModifierList
  left: index TableSource
  right: index TableSource
  on_expr: index Expr
  using_columns: index ExprList

  fmt {
    switch(join_type) {
      COMMA {
        child(left) "," space child(right)
        if_set(on_expr) { hardline "ON" space child(on_expr) }
        if_set(using_columns) { group { space "USING" space "(" nest { softline child(using_columns) } softline ")" } }
      }
      default {
        child(left) hardline
        group {
          if_set(modifiers) { child(modifiers) space }
          "JOIN"
          space child(right)
          if_set(on_expr) { nest { line "ON" space child(on_expr) } }
          if_set(using_columns) { group { space "USING" space "(" nest { softline child(using_columns) } softline ")" } }
        }
      }
    }
  }
}

node JoinPrefix {
  source: index TableSource
  join_type: inline JoinType
  modifiers: index JoinModifierList

  fmt { child(source) }
}

abstract TableSource {
  TableRef SubqueryTableSource ParenTableSource JoinClause JoinPrefix
}
