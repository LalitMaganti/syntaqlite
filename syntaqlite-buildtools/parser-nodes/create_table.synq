// Authored temporary qualifier; NONE means a persistent object.
enum TemporaryQualifier { NONE TEMP TEMPORARY }

enum ForeignKeyAction { UNSET NO_ACTION SET_NULL SET_DEFAULT CASCADE RESTRICT }
enum Deferrable { UNSET NOT_DEFERRABLE DEFERRABLE }
enum InitialDeferMode { UNSET DEFERRED IMMEDIATE }
enum GeneratedColumnStorage { NONE VIRTUAL STORED }
enum ColumnConstraintType { DEFAULT NOT_NULL PRIMARY_KEY UNIQUE CHECK REFERENCES COLLATE GENERATED NULL DEFERRABLE }
enum TableConstraintType { PRIMARY_KEY UNIQUE CHECK FOREIGN_KEY }

flags CreateTableStmtFlags { WITHOUT_ROWID = 1 STRICT = 2 }

enum ForeignKeyOptionKind { MATCH ON_DELETE ON_UPDATE ON_INSERT }

node ForeignKeyOption {
  kind: inline ForeignKeyOptionKind
  action: inline ForeignKeyAction
  match_name: inline SyntaqliteTextSpan

  fmt {
    if_enum(kind, MATCH) { "MATCH" space span(match_name) } else {
      "ON" space enum_display(kind, {
        MATCH="" ON_DELETE="DELETE" ON_UPDATE="UPDATE" ON_INSERT="INSERT"
      })
      space switch(action) {
        NO_ACTION { "NO" "ACTION" }
        SET_NULL { "SET" "NULL" }
        SET_DEFAULT { "SET" "DEFAULT" }
        CASCADE { "CASCADE" }
        RESTRICT { "RESTRICT" }
      }
    }
  }
}

list ForeignKeyOptionList {
  ForeignKeyOption
  fmt { for_each(sep: line) { child(_item) } }
}

node ForeignKeyClause {
  ref_table: inline SyntaqliteTextSpan
  ref_columns: index ExprList
  options: index ForeignKeyOptionList
  deferrable: inline Deferrable
  initial_defer: inline InitialDeferMode

  fmt {
    group {
      if_span(ref_table) { "REFERENCES" space span(ref_table) }
      if_set(ref_columns) { group { "(" nest { softline child(ref_columns) } softline ")" } }
      nest {
        if_set(options) { line child(options) }
        switch(deferrable) {
          NOT_DEFERRABLE { line "NOT" "DEFERRABLE" }
          DEFERRABLE     { line "DEFERRABLE" }
        }
        switch(initial_defer) {
          DEFERRED  { space "INITIALLY" "DEFERRED" }
          IMMEDIATE { space "INITIALLY" "IMMEDIATE" }
        }
      }
    }
  }
}

node ColumnConstraint {
  kind: inline ColumnConstraintType
  onconf: inline ConflictAction
  sort_order: inline SortOrder
  is_autoincrement: inline Bool
  collation_name: inline SyntaqliteTextSpan
  generated_storage: inline GeneratedColumnStorage
  deferrable: inline Deferrable
  initial_defer: inline InitialDeferMode
  // Only `DEFAULT ( expr )` is parenthesised upstream; adding parens to the
  // other three productions changes a bare identifier from a string literal
  // into a column reference.
  default_has_parens: inline Bool
  // `GENERATED ALWAYS AS` and bare `AS` are separate productions; only one
  // writes the keywords.
  generated_always: inline Bool
  default_expr: index Expr
  check_expr: index Expr
  generated_expr: index Expr
  fk_clause: index ForeignKeyClause

  fmt {
    switch(kind) {
      PRIMARY_KEY {
        "PRIMARY" "KEY"
        if_enum(sort_order, ASC) { space "ASC" }
        if_enum(sort_order, DESC) { space "DESC" }
        switch(onconf) {
          ROLLBACK { space "ON" "CONFLICT" "ROLLBACK" }
          ABORT    { space "ON" "CONFLICT" "ABORT" }
          FAIL     { space "ON" "CONFLICT" "FAIL" }
          IGNORE   { space "ON" "CONFLICT" "IGNORE" }
          REPLACE  { space "ON" "CONFLICT" "REPLACE" }
        }
        if_flag(is_autoincrement) { space "AUTOINCREMENT" }
      }
      NOT_NULL {
        "NOT" "NULL"
        switch(onconf) {
          ROLLBACK { space "ON" "CONFLICT" "ROLLBACK" }
          ABORT    { space "ON" "CONFLICT" "ABORT" }
          FAIL     { space "ON" "CONFLICT" "FAIL" }
          IGNORE   { space "ON" "CONFLICT" "IGNORE" }
          REPLACE  { space "ON" "CONFLICT" "REPLACE" }
        }
      }
      UNIQUE {
        "UNIQUE"
        switch(onconf) {
          ROLLBACK { space "ON" "CONFLICT" "ROLLBACK" }
          ABORT    { space "ON" "CONFLICT" "ABORT" }
          FAIL     { space "ON" "CONFLICT" "FAIL" }
          IGNORE   { space "ON" "CONFLICT" "IGNORE" }
          REPLACE  { space "ON" "CONFLICT" "REPLACE" }
        }
      }
      CHECK     { group { "CHECK(" nest { softline child(check_expr) } softline ")" } }
      DEFAULT {
        "DEFAULT" space
        if_flag(default_has_parens) {
          group { "(" nest { softline child(default_expr) } softline ")" }
        } else {
          child(default_expr)
        }
      }
      COLLATE   { "COLLATE" space span(collation_name) }
      REFERENCES { child(fk_clause) }
      GENERATED {
        if_flag(generated_always) { "GENERATED" "ALWAYS" space }
        group { "AS" space "(" nest { softline child(generated_expr) } softline ")" }
        if_enum(generated_storage, VIRTUAL) { space "VIRTUAL" }
        if_enum(generated_storage, STORED) { space "STORED" }
      }
      NULL {
        "NULL"
        switch(onconf) {
          ROLLBACK { space "ON" "CONFLICT" "ROLLBACK" }
          ABORT    { space "ON" "CONFLICT" "ABORT" }
          FAIL     { space "ON" "CONFLICT" "FAIL" }
          IGNORE   { space "ON" "CONFLICT" "IGNORE" }
          REPLACE  { space "ON" "CONFLICT" "REPLACE" }
        }
      }
      DEFERRABLE {
        switch(deferrable) {
          NOT_DEFERRABLE { "NOT" "DEFERRABLE" }
          DEFERRABLE     { "DEFERRABLE" }
        }
        switch(initial_defer) {
          DEFERRED  { space "INITIALLY" "DEFERRED" }
          IMMEDIATE { space "INITIALLY" "IMMEDIATE" }
        }
      }
    }
  }
}

// Each authored declaration occurs once, even if another declaration replaces
// it before a constraint. The effective name is the latest declaration in the
// column's ordered sequence; it is not duplicated onto each constraint.
node ConstraintNameDeclaration {
  name: inline SyntaqliteTextSpan
  fmt { "CONSTRAINT" space span(name) }
}

abstract ColumnConstraintItem {
  ConstraintNameDeclaration ColumnConstraint
}

list ColumnConstraintList {
  ColumnConstraintItem
  fmt { for_each(sep: line) { child(_item) } }
}

node ColumnDef {
  column_name: index Name
  type_name: inline SyntaqliteTextSpan
  constraints: index ColumnConstraintList

  semantic { column_def(name: column_name, type: type_name, constraints: constraints) }

  fmt {
    group {
      child(column_name)
      if_span(type_name) { space span(type_name) }
      if_set(constraints) { nest { line child(constraints) } }
    }
  }
}

list ColumnDefList {
  ColumnDef
  fmt { for_each(sep: "," line) { child(_item) } }
}

node TableConstraint {
  kind: inline TableConstraintType
  onconf: inline ConflictAction
  is_autoincrement: inline Bool
  pk_columns: index OrderByList
  fk_columns: index ExprList
  check_expr: index Expr
  fk_clause: index ForeignKeyClause

  fmt {
    switch(kind) {
      PRIMARY_KEY {
        group { "PRIMARY" "KEY(" nest { softline child(pk_columns) } softline ")" }
        switch(onconf) {
          ROLLBACK { space "ON" "CONFLICT" "ROLLBACK" }
          ABORT    { space "ON" "CONFLICT" "ABORT" }
          FAIL     { space "ON" "CONFLICT" "FAIL" }
          IGNORE   { space "ON" "CONFLICT" "IGNORE" }
          REPLACE  { space "ON" "CONFLICT" "REPLACE" }
        }
      }
      UNIQUE {
        group { "UNIQUE(" nest { softline child(pk_columns) } softline ")" }
        switch(onconf) {
          ROLLBACK { space "ON" "CONFLICT" "ROLLBACK" }
          ABORT    { space "ON" "CONFLICT" "ABORT" }
          FAIL     { space "ON" "CONFLICT" "FAIL" }
          IGNORE   { space "ON" "CONFLICT" "IGNORE" }
          REPLACE  { space "ON" "CONFLICT" "REPLACE" }
        }
      }
      CHECK {
        group { "CHECK(" nest { softline child(check_expr) } softline ")" }
        switch(onconf) {
          ROLLBACK { space "ON" "CONFLICT" "ROLLBACK" }
          ABORT    { space "ON" "CONFLICT" "ABORT" }
          FAIL     { space "ON" "CONFLICT" "FAIL" }
          IGNORE   { space "ON" "CONFLICT" "IGNORE" }
          REPLACE  { space "ON" "CONFLICT" "REPLACE" }
        }
      }
      FOREIGN_KEY { group { "FOREIGN" "KEY(" nest { softline child(fk_columns) } softline ")" } space child(fk_clause) }
    }
  }
}

abstract TableConstraintItem {
  ConstraintNameDeclaration TableConstraint
}

// Within table constraints, a comma ends the pending-name scope. The first
// group can inherit the last column's name. Keep authored groups instead of
// inserting commas and repeating the effective name on each item.
list TableConstraintGroup {
  TableConstraintItem
  fmt { group { for_each(sep: line) { child(_item) } } }
}

list TableConstraintList {
  TableConstraintGroup
  fmt { for_each(sep: "," line) { child(_item) } }
}

node CreateTableStmt {
  table_name: inline SyntaqliteTextSpan
  schema: inline SyntaqliteTextSpan
  temporary: inline TemporaryQualifier
  if_not_exists: inline Bool
  flags: inline CreateTableStmtFlags
  columns: index ColumnDefList
  table_constraints: index TableConstraintList
  as_select: index Select

  semantic { define_table(name: table_name, columns: columns, select: as_select, without_rowid: flags.without_rowid) }

  fmt {
    group {
      "CREATE"
      switch(temporary) {
        TEMP { space "TEMP" }
        TEMPORARY { space "TEMPORARY" }
      }
      space "TABLE"
      if_flag(if_not_exists) { space "IF" "NOT" "EXISTS" }
      space
      if_span(schema) { span(schema) "." }
      span(table_name)
      if_set(columns) {
        "("
        nest {
          softline
          child(columns)
          if_set(table_constraints) { "," line child(table_constraints) }
        }
        softline ")"
      }
      if_set(as_select) { line "AS" }
      if_flag(flags.without_rowid) {
        space "WITHOUT" "ROWID"
        if_flag(flags.strict) { "," }
      }
      if_flag(flags.strict) { space "STRICT" }
    }
    if_set(as_select) { hardline child(as_select) }
  }
}
