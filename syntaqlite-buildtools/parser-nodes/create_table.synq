enum ForeignKeyAction { UNSET NO_ACTION SET_NULL SET_DEFAULT CASCADE RESTRICT }
enum GeneratedColumnStorage { VIRTUAL STORED }
enum ColumnConstraintType { DEFAULT NOT_NULL PRIMARY_KEY UNIQUE CHECK REFERENCES COLLATE GENERATED NULL }
enum TableConstraintType { PRIMARY_KEY UNIQUE CHECK FOREIGN_KEY }

flags CreateTableStmtFlags { WITHOUT_ROWID = 1 STRICT = 2 }

node ForeignKeyClause {
  ref_table: inline SyntaqliteTextSpan
  ref_columns: index ExprList
  match_name: inline SyntaqliteTextSpan
  on_delete: inline ForeignKeyAction
  on_update: inline ForeignKeyAction
  on_insert: inline ForeignKeyAction
  is_deferred: inline Bool

  fmt {
    if_span(ref_table) { "REFERENCES" space span(ref_table) }
    if_set(ref_columns) { group { "(" nest { softline child(ref_columns) } softline ")" } }
    if_span(match_name) { space "MATCH" space span(match_name) }
    switch(on_delete) {
      NO_ACTION   { space "ON" "DELETE" "NO" "ACTION" }
      SET_NULL    { space "ON" "DELETE" "SET" "NULL" }
      SET_DEFAULT { space "ON" "DELETE" "SET" "DEFAULT" }
      CASCADE     { space "ON" "DELETE" "CASCADE" }
      RESTRICT    { space "ON" "DELETE" "RESTRICT" }
    }
    switch(on_update) {
      NO_ACTION   { space "ON" "UPDATE" "NO" "ACTION" }
      SET_NULL    { space "ON" "UPDATE" "SET" "NULL" }
      SET_DEFAULT { space "ON" "UPDATE" "SET" "DEFAULT" }
      CASCADE     { space "ON" "UPDATE" "CASCADE" }
      RESTRICT    { space "ON" "UPDATE" "RESTRICT" }
    }
    switch(on_insert) {
      NO_ACTION   { space "ON" "INSERT" "NO" "ACTION" }
      SET_NULL    { space "ON" "INSERT" "SET" "NULL" }
      SET_DEFAULT { space "ON" "INSERT" "SET" "DEFAULT" }
      CASCADE     { space "ON" "INSERT" "CASCADE" }
      RESTRICT    { space "ON" "INSERT" "RESTRICT" }
    }
    if_flag(is_deferred) { if_span(ref_table) { space } "DEFERRABLE" "INITIALLY" "DEFERRED" }
  }
}

node ColumnConstraint {
  kind: inline ColumnConstraintType
  constraint_name: inline SyntaqliteTextSpan
  onconf: inline ConflictAction
  sort_order: inline SortOrder
  is_autoincrement: inline Bool
  collation_name: inline SyntaqliteTextSpan
  generated_storage: inline GeneratedColumnStorage
  default_expr: index Expr
  check_expr: index Expr
  generated_expr: index Expr
  fk_clause: index ForeignKeyClause

  fmt {
    if_span(constraint_name) { "CONSTRAINT" space span(constraint_name) space }
    switch(kind) {
      PRIMARY_KEY {
        "PRIMARY" "KEY"
        if_enum(sort_order, DESC) { space "DESC" }
        if_flag(is_autoincrement) { space "AUTOINCREMENT" }
        switch(onconf) {
          ROLLBACK { space "ON" "CONFLICT" "ROLLBACK" }
          ABORT    { space "ON" "CONFLICT" "ABORT" }
          FAIL     { space "ON" "CONFLICT" "FAIL" }
          IGNORE   { space "ON" "CONFLICT" "IGNORE" }
          REPLACE  { space "ON" "CONFLICT" "REPLACE" }
        }
      }
      NOT_NULL {
        "NOT" "NULL"
        switch(onconf) {
          ROLLBACK { space "ON" "CONFLICT" "ROLLBACK" }
          ABORT    { space "ON" "CONFLICT" "ABORT" }
          FAIL     { space "ON" "CONFLICT" "FAIL" }
          IGNORE   { space "ON" "CONFLICT" "IGNORE" }
          REPLACE  { space "ON" "CONFLICT" "REPLACE" }
        }
      }
      UNIQUE {
        "UNIQUE"
        switch(onconf) {
          ROLLBACK { space "ON" "CONFLICT" "ROLLBACK" }
          ABORT    { space "ON" "CONFLICT" "ABORT" }
          FAIL     { space "ON" "CONFLICT" "FAIL" }
          IGNORE   { space "ON" "CONFLICT" "IGNORE" }
          REPLACE  { space "ON" "CONFLICT" "REPLACE" }
        }
      }
      CHECK     { group { "CHECK(" nest { softline child(check_expr) } softline ")" } }
      DEFAULT   { group { "DEFAULT" space "(" nest { softline child(default_expr) } softline ")" } }
      COLLATE   { "COLLATE" space span(collation_name) }
      REFERENCES { child(fk_clause) }
      GENERATED {
        group { "AS" space "(" nest { softline child(generated_expr) } softline ")" }
        if_enum(generated_storage, STORED) { space "STORED" }
      }
      NULL { "NULL" }
    }
  }
}

list ColumnConstraintList {
  ColumnConstraint
  fmt { for_each(sep: line) { child(_item) } }
}

node ColumnDef {
  column_name: index Name
  type_name: inline SyntaqliteTextSpan
  constraints: index ColumnConstraintList

  semantic { column_def(name: column_name, type: type_name, constraints: constraints) }

  fmt {
    group {
      child(column_name)
      if_span(type_name) { space span(type_name) }
      if_set(constraints) { nest { line child(constraints) } }
    }
  }
}

list ColumnDefList {
  ColumnDef
  fmt { for_each(sep: "," line) { child(_item) } }
}

node TableConstraint {
  kind: inline TableConstraintType
  constraint_name: inline SyntaqliteTextSpan
  onconf: inline ConflictAction
  is_autoincrement: inline Bool
  pk_columns: index OrderByList
  fk_columns: index ExprList
  check_expr: index Expr
  fk_clause: index ForeignKeyClause

  fmt {
    if_span(constraint_name) { "CONSTRAINT" space span(constraint_name) space }
    switch(kind) {
      PRIMARY_KEY {
        group { "PRIMARY" "KEY(" nest { softline child(pk_columns) } softline ")" }
        switch(onconf) {
          ROLLBACK { space "ON" "CONFLICT" "ROLLBACK" }
          ABORT    { space "ON" "CONFLICT" "ABORT" }
          FAIL     { space "ON" "CONFLICT" "FAIL" }
          IGNORE   { space "ON" "CONFLICT" "IGNORE" }
          REPLACE  { space "ON" "CONFLICT" "REPLACE" }
        }
      }
      UNIQUE {
        group { "UNIQUE(" nest { softline child(pk_columns) } softline ")" }
        switch(onconf) {
          ROLLBACK { space "ON" "CONFLICT" "ROLLBACK" }
          ABORT    { space "ON" "CONFLICT" "ABORT" }
          FAIL     { space "ON" "CONFLICT" "FAIL" }
          IGNORE   { space "ON" "CONFLICT" "IGNORE" }
          REPLACE  { space "ON" "CONFLICT" "REPLACE" }
        }
      }
      CHECK       { group { "CHECK(" nest { softline child(check_expr) } softline ")" } }
      FOREIGN_KEY { group { "FOREIGN" "KEY(" nest { softline child(fk_columns) } softline ")" } space child(fk_clause) }
    }
  }
}

list TableConstraintList {
  TableConstraint
  fmt { for_each(sep: "," line) { child(_item) } }
}

node CreateTableStmt {
  table_name: inline SyntaqliteTextSpan
  schema: inline SyntaqliteTextSpan
  is_temp: inline Bool
  if_not_exists: inline Bool
  flags: inline CreateTableStmtFlags
  columns: index ColumnDefList
  table_constraints: index TableConstraintList
  as_select: index Select

  semantic { define_table(name: table_name, columns: columns, select: as_select, without_rowid: flags.without_rowid) }

  fmt {
    group {
      "CREATE"
      if_flag(is_temp) { space "TEMP" }
      space "TABLE"
      if_flag(if_not_exists) { space "IF" "NOT" "EXISTS" }
      space
      if_span(schema) { span(schema) "." }
      span(table_name)
      if_set(columns) {
        "("
        nest {
          softline
          child(columns)
          if_set(table_constraints) { "," line child(table_constraints) }
        }
        softline ")"
      }
      if_set(as_select) { line "AS" }
      if_flag(flags.without_rowid) {
        space "WITHOUT" "ROWID"
        if_flag(flags.strict) { "," }
      }
      if_flag(flags.strict) { space "STRICT" }
    }
    if_set(as_select) { hardline child(as_select) }
  }
}
