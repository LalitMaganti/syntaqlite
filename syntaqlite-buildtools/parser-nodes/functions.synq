flags FunctionCallFlags { DISTINCT = 1 STAR = 2 ALL = 4 }

node FunctionCall {
  func_name: inline SyntaqliteTextSpan
  flags: inline FunctionCallFlags
  args: index ExprList
  filter_clause: index Expr
  over_clause: index WindowDef

  semantic { call(name: func_name, args: args) }

  fmt {
    span(func_name)
    group {
      "("
      if_flag(flags.distinct) { "DISTINCT" space }
      if_flag(flags.all) { "ALL" space }
      if_flag(flags.star) { "*" } else {
        if_set(args) { nest { softline child(args) } }
      }
      softline ")"
    }
    if_set(filter_clause) { group { space "FILTER" space "(" nest { softline "WHERE" space child(filter_clause) } softline ")" } }
    if_set(over_clause) { space "OVER" space child(over_clause) }
  }
}
