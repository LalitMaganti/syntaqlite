enum ConflictAction { DEFAULT ROLLBACK ABORT FAIL IGNORE REPLACE }

enum UpsertAction { NOTHING UPDATE }

enum IndexHint { DEFAULT NOT_INDEXED INDEXED }

node UpsertClause {
  columns: index OrderByList
  target_where: index Expr
  action: inline UpsertAction
  setlist: index SetClauseList
  update_where: index Expr

  fmt {
    "ON" "CONFLICT"
    if_set(columns) { group { space "(" nest { softline child(columns) } softline ")" } }
    if_set(target_where) { space "WHERE" space child(target_where) }
    if_enum(action, UPDATE) {
      space "DO" "UPDATE"
      clause("SET", setlist)
      clause("WHERE", update_where)
    } else {
      space "DO" "NOTHING"
    }
  }
}

list UpsertClauseList {
  UpsertClause
  prepend
  fmt { for_each(sep: hardline) { child(_item) } }
}

node DeleteStmt {
  with_ctes: index CteList
  with_recursive: inline Bool
  table: index TableRef
  index_hint: inline IndexHint
  index_name: inline SyntaqliteTextSpan
  where_clause: index Expr
  orderby: index OrderByList
  limit_clause: index LimitClause
  returning: index ResultColumnList

  semantic { dml_scope(with_recursive: with_recursive, with_ctes: with_ctes) }

  fmt {
    group {
      if_set(with_ctes) {
        if_flag(with_recursive) { "WITH" "RECURSIVE" } else { "WITH" }
        group { nest { line child(with_ctes) } } hardline
      }
      "DELETE" "FROM" space child(table)
      switch(index_hint) {
        INDEXED { space "INDEXED" "BY" space span(index_name) }
        NOT_INDEXED { space "NOT" "INDEXED" }
      }
      clause("WHERE", where_clause)
      clause("ORDER", "BY", orderby)
      if_set(limit_clause) { line "LIMIT" space child(limit_clause) }
      if_set(returning) { line "RETURNING" group { nest { line child(returning) } } }
    }
  }
}

node SetClause {
  column: inline SyntaqliteTextSpan
  columns: index ExprList
  value: index Expr

  fmt {
    if_span(column) { span(column) } else {
      if_set(columns) { group { "(" nest { softline child(columns) } softline ")" } }
    }
    space "=" space child_paren_list(value)
  }
}

list SetClauseList { SetClause }

node UpdateStmt {
  with_ctes: index CteList
  with_recursive: inline Bool
  conflict_action: inline ConflictAction
  table: index TableRef
  index_hint: inline IndexHint
  index_name: inline SyntaqliteTextSpan
  setlist: index SetClauseList
  from_clause: index TableSource
  where_clause: index Expr
  orderby: index OrderByList
  limit_clause: index LimitClause
  returning: index ResultColumnList

  semantic { dml_scope(with_recursive: with_recursive, with_ctes: with_ctes) }

  fmt {
    group {
      if_set(with_ctes) {
        if_flag(with_recursive) { "WITH" "RECURSIVE" } else { "WITH" }
        group { nest { line child(with_ctes) } } hardline
      }
      "UPDATE"
      switch(conflict_action) {
        ROLLBACK { space "OR" "ROLLBACK" }
        ABORT    { space "OR" "ABORT" }
        FAIL     { space "OR" "FAIL" }
        IGNORE   { space "OR" "IGNORE" }
        REPLACE  { space "OR" "REPLACE" }
      }
      space child(table)
      switch(index_hint) {
        INDEXED { space "INDEXED" "BY" space span(index_name) }
        NOT_INDEXED { space "NOT" "INDEXED" }
      }
      clause("SET", setlist)
      if_set(from_clause) { line "FROM" space child(from_clause) }
      clause("WHERE", where_clause)
      clause("ORDER", "BY", orderby)
      if_set(limit_clause) { line "LIMIT" space child(limit_clause) }
      if_set(returning) { line "RETURNING" group { nest { line child(returning) } } }
    }
  }
}

node InsertStmt {
  with_ctes: index CteList
  with_recursive: inline Bool
  conflict_action: inline ConflictAction
  table: index TableRef
  columns: index ExprList
  source: index Select
  upsert: index UpsertClauseList
  returning: index ResultColumnList

  semantic { dml_scope(with_recursive: with_recursive, with_ctes: with_ctes) }

  fmt {
    group {
      if_set(with_ctes) {
        if_flag(with_recursive) { "WITH" "RECURSIVE" } else { "WITH" }
        group { nest { line child(with_ctes) } } hardline
      }
      if_enum(conflict_action, REPLACE) { "REPLACE" } else {
        "INSERT"
        switch(conflict_action) {
          ROLLBACK { space "OR" "ROLLBACK" }
          ABORT    { space "OR" "ABORT" }
          FAIL     { space "OR" "FAIL" }
          IGNORE   { space "OR" "IGNORE" }
        }
      }
      space "INTO" space child(table)
      if_set(columns) { group { "(" nest { softline child(columns) } softline ")" } }
      if_set(source) { line child(source) } else { space "DEFAULT" "VALUES" }
      if_set(upsert) { line child(upsert) }
      if_set(returning) { line "RETURNING" group { nest { line child(returning) } } }
    }
  }
}
