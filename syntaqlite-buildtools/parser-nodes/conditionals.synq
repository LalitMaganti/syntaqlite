enum IsOp { IS IS_NOT IS_NULL NOT_NULL IS_NOT_DISTINCT IS_DISTINCT }

node IsExpr {
  op: inline IsOp
  left: index Expr
  right: index Expr

  fmt_precedence(3)
  fmt_group(0)

  fmt {
    switch(op) {
      IS_NULL         { child_prec_fixed(left) space "ISNULL" }
      NOT_NULL        { child_prec_fixed(left) space "NOTNULL" }
      IS              { child_prec_fixed(left) space "IS" space child_prec_fixed(right, right) }
      IS_NOT          { child_prec_fixed(left) space "IS" "NOT" space child_prec_fixed(right, right) }
      IS_NOT_DISTINCT { child_prec_fixed(left) space "IS" "NOT" "DISTINCT" "FROM" space child_prec_fixed(right, right) }
      IS_DISTINCT     { child_prec_fixed(left) space "IS" "DISTINCT" "FROM" space child_prec_fixed(right, right) }
    }
  }
}

node BetweenExpr {
  negated: inline Bool
  operand: index Expr
  low: index Expr
  high: index Expr

  fmt_precedence(3)
  fmt_group(0)

  fmt {
    child_prec_fixed(operand)
    if_flag(negated) { space "NOT" "BETWEEN" space } else { space "BETWEEN" space }
    child(low) space "AND" space child(high)
  }
}

enum LikeKeyword { LIKE GLOB MATCH REGEXP }

node LikeExpr {
  negated: inline Bool
  keyword: inline LikeKeyword
  operand: index Expr
  pattern: index Expr
  escape: index Expr

  fmt_precedence(3)
  fmt_group(0)

  fmt {
    child_prec_fixed(operand)
    if_flag(negated) { space "NOT" space } else { space }
    switch(keyword) {
      LIKE   { "LIKE" }
      GLOB   { "GLOB" }
      MATCH  { "MATCH" }
      REGEXP { "REGEXP" }
    }
    space child(pattern)
    if_set(escape) { space "ESCAPE" space child(escape) }
  }
}

node CaseExpr {
  operand: index Expr
  else_expr: index Expr
  whens: index CaseWhenList

  fmt {
    group {
      "CASE"
      if_set(operand) { space child_paren_list(operand) }
      nest {
        if_set(whens) { child(whens) }
        if_set(else_expr) { line "ELSE" space child(else_expr) }
      }
      line "END"
    }
  }
}

node CaseWhen {
  when_expr: index Expr
  then_expr: index Expr

  fmt { line "WHEN" space child(when_expr) space "THEN" space child(then_expr) }
}

list CaseWhenList {
  CaseWhen
  fmt { for_each { child(_item) } }
}
