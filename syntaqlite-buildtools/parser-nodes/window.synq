enum FrameType { NONE RANGE ROWS GROUPS }
enum FrameBoundType { UNBOUNDED_PRECEDING EXPR_PRECEDING CURRENT_ROW EXPR_FOLLOWING UNBOUNDED_FOLLOWING }
enum FrameExclude { NONE NO_OTHERS CURRENT_ROW GROUP TIES }

node FrameBound {
  bound_type: inline FrameBoundType
  expr: index Expr

  fmt {
    switch(bound_type) {
      UNBOUNDED_PRECEDING { "UNBOUNDED" "PRECEDING" }
      EXPR_PRECEDING      { child_paren_list(expr) space "PRECEDING" }
      CURRENT_ROW         { "CURRENT" "ROW" }
      EXPR_FOLLOWING      { child_paren_list(expr) space "FOLLOWING" }
      UNBOUNDED_FOLLOWING { "UNBOUNDED" "FOLLOWING" }
    }
  }
}

node FrameSpec {
  frame_type: inline FrameType
  exclude: inline FrameExclude
  start_bound: index FrameBound
  end_bound: index FrameBound

  fmt {
    switch(frame_type) {
      RANGE  { "RANGE" }
      ROWS   { "ROWS" }
      GROUPS { "GROUPS" }
    }
    space "BETWEEN" space child(start_bound) space "AND" space child(end_bound)
    switch(exclude) {
      NO_OTHERS   { space "EXCLUDE" "NO" "OTHERS" }
      CURRENT_ROW { space "EXCLUDE" "CURRENT" "ROW" }
      GROUP       { space "EXCLUDE" "GROUP" }
      TIES        { space "EXCLUDE" "TIES" }
    }
  }
}

node WindowDef {
  base_window_name: inline SyntaqliteTextSpan
  partition_by: index ExprList
  orderby: index OrderByList
  frame: index FrameSpec

  fmt {
    if_span(base_window_name) { span(base_window_name) } else {
      group {
        "("
        nest {
          softline
          if_set(partition_by) { "PARTITION" "BY" nest { line child(partition_by) } }
          if_set(orderby) {
            if_set(partition_by) { line }
            "ORDER" "BY" group { nest { line child(orderby) } }
          }
          if_set(frame) {
            if_set(partition_by) { line } else {
              if_set(orderby) { line }
            }
            child(frame)
          }
        }
        softline ")"
      }
    }
  }
}

list WindowDefList { WindowDef }

node NamedWindowDef {
  window_name: inline SyntaqliteTextSpan
  window_def: index WindowDef

  fmt { span(window_name) space "AS" space child(window_def) }
}

list NamedWindowDefList { NamedWindowDef }

node FilterOver {
  filter_expr: index Expr
  over_def: index WindowDef
  over_name: inline SyntaqliteTextSpan

  fmt {
    if_set(filter_expr) { group { "FILTER" space "(" nest { softline "WHERE" space child(filter_expr) } softline ")" } }
    if_set(over_def) { space "OVER" space child(over_def) }
    if_span(over_name) { space "OVER" space span(over_name) }
  }
}
