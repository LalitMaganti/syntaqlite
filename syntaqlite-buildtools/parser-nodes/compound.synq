abstract Select {
  SelectStmt CompoundSelect WithClause ValuesClause
}

enum CompoundOp { UNION UNION_ALL INTERSECT EXCEPT }

node CompoundSelect {
  op: inline CompoundOp
  left: index Select
  right: index Select
  // ORDER BY / LIMIT parse inside the last arm (upstream grammar shape)
  // but apply to the whole compound — the fold hoists them here.
  orderby: index OrderByList
  limit_clause: index LimitClause

  semantic { compound_scope(left: left, right: right, orderby: orderby, limit_clause: limit_clause) }

  fmt {
    child(left) hardline
    switch(op) {
      UNION       { "UNION" }
      UNION_ALL   { "UNION" "ALL" }
      INTERSECT   { "INTERSECT" }
      EXCEPT      { "EXCEPT" }
    }
    hardline child(right)
    group {
      clause("ORDER", "BY", orderby)
      if_set(limit_clause) { line "LIMIT" space child(limit_clause) }
    }
  }
}

node SubqueryExpr {
  select: index Select

  fmt { group { "(" nest { softline child(select) } softline ")" } }
}

node ExistsExpr {
  select: index Select

  fmt { "EXISTS" space group { "(" nest { softline child(select) } softline ")" } }
}

abstract InExprSource {
  ExprList SubqueryExpr SelectStmt CompoundSelect WithClause ValuesClause TableRef
}

node InExpr {
  negated: inline Bool
  bare_source: inline Bool
  operand: index Expr
  source: index InExprSource

  fmt_precedence(3)
  fmt_group(0)

  fmt {
    child_prec_fixed(operand)
    if_flag(negated) { space "NOT" "IN" space } else { space "IN" space }
    if_flag(bare_source) {
      child(source)
    } else {
      group { "(" nest { softline child(source) } softline ")" }
    }
  }
}
