enum TriggerTiming { BEFORE AFTER INSTEAD_OF }
enum TriggerEventType { DELETE INSERT UPDATE }

node TriggerEvent {
  event_type: inline TriggerEventType
  columns: index ExprList

  fmt {
    switch(event_type) {
      DELETE { "DELETE" }
      INSERT { "INSERT" }
      UPDATE {
        "UPDATE"
        if_set(columns) { group { space "OF" space child(columns) } }
      }
    }
  }
}

list TriggerCmdList {
  Stmt
  fmt {
    for_each(sep: hardline) { child(_item) ";" }
  }
}

node CreateTriggerStmt {
  trigger_name: inline SyntaqliteTextSpan
  schema: inline SyntaqliteTextSpan
  is_temp: inline Bool
  if_not_exists: inline Bool
  timing: inline TriggerTiming
  event: index TriggerEvent
  table: index QualifiedName
  when_expr: index Expr
  body: index TriggerCmdList

  semantic { trigger_scope(target: table, when: when_expr, body: body) }

  fmt {
    "CREATE"
    if_flag(is_temp) { space "TEMP" }
    space "TRIGGER"
    if_flag(if_not_exists) { space "IF" "NOT" "EXISTS" }
    space
    if_span(schema) { span(schema) "." }
    span(trigger_name) space
    switch(timing) {
      BEFORE     { "BEFORE" }
      AFTER      { "AFTER" }
      INSTEAD_OF { "INSTEAD" "OF" }
    }
    space child(event) space "ON" space child(table)
    if_set(when_expr) { hardline "WHEN" space child(when_expr) }
    hardline "BEGIN"
    if_set(body) { nest { hardline child(body) } }
    hardline "END"
  }
}

node CreateVirtualTableStmt {
  table_name: inline SyntaqliteTextSpan
  schema: inline SyntaqliteTextSpan
  module_name: inline SyntaqliteTextSpan
  if_not_exists: inline Bool
  module_args: inline SyntaqliteTextSpan

  fmt {
    "CREATE" "VIRTUAL" "TABLE"
    if_flag(if_not_exists) { space "IF" "NOT" "EXISTS" }
    space
    if_span(schema) { span(schema) "." }
    span(table_name)
    space "USING" space span(module_name)
    if_span(module_args) { "(" span(module_args) ")" }
  }

  semantic { define_table(name: table_name) }
}
