node BinaryExpr {
  op: inline BinaryOp
  left: index Expr
  right: index Expr

  fmt {
    switch(op) {
      AND { child_prec(left, op) line "AND" space child_prec(right, op, right) }
      OR  { child_prec(left, op) line "OR" space  child_prec(right, op, right) }
      default {
        group {
          child_prec(left, op) line
          enum_display(op, {
            PLUS="+" MINUS="-" STAR="*" SLASH="/" REM="%"
            LT="<" GT=">" LE="<=" GE=">=" EQ="=" NE="!="
            AND="AND" OR="OR" BIT_AND="&" BIT_OR="|"
            LSHIFT="<<" RSHIFT=">>" CONCAT="||" PTR="->" PTR2="->>"
          })
          space child_prec(right, op, right)
        }
      }
    }
  }
}

node UnaryExpr {
  op: inline UnaryOp
  operand: index Expr

  fmt {
    switch(op) {
      NOT     { "NOT" space child_prec(operand, op) }
      MINUS   { "-" child_prec(operand, op) }
      PLUS    { "+" child_prec(operand, op) }
      BIT_NOT { "~" child_prec(operand, op) }
    }
  }
}

node Literal {
  literal_type: inline LiteralType
  source: inline SyntaqliteTextSpan

  fmt { span(source) }
}

// A parenthesized expression: `(inner)`.  Preserved as a real node so
// the formatter can round-trip author-written parens and so macro-arg
// re-parses don't silently strip list-vs-expr distinguishing parens
// (e.g. `_interval_intersect!(..., (utid))` where the second arg is a
// one-element ColumnNameList, syntactically indistinguishable from a
// bare identifier without the parens).
//
// Max precedence (255) makes the ParenExpr itself "tighter than any
// operator," so a parent emitting `child_prec_fixed(paren_expr)` will
// never add another paren layer around it.  Inside, we emit the inner
// expression without a precedence check — the explicit `(` `)` we
// print here already satisfy any wrapping the child might need.
node ParenExpr {
  expr: index Expr

  fmt_precedence(255)

  // Wrap in a `group` so line-break decisions inside the inner
  // expression are isolated: if the whole `(expr)` fits on one line we
  // keep it flat, otherwise the inner expression breaks at its own
  // `line` points without affecting the outer context.  This also
  // makes formatting idempotent — one pass can't linebreak a paren
  // body that the previous pass decided to keep flat.
  fmt { group { "(" child(expr) ")" } }
}

node IdentName {
  source: inline SyntaqliteTextSpan

  fmt { span(source) }
}

node Error {
  source: inline SyntaqliteTextSpan

  fmt {
    if_span(source) {
      span(source)
    } else {
      "<error>"
    }
  }
}

// `(a, b)` in an expression position. Upstream models this as TK_VECTOR:
// without a node of its own the parens are lost wherever the surrounding
// context does not supply them, and nested lists splice into their parent.
node RowValue {
  items: index ExprList

  fmt { group { "(" nest { softline child(items) } softline ")" } }
}

list ExprList { Expr }

abstract Name {
  IdentName Error
}

abstract Expr {
  BinaryExpr UnaryExpr ParenExpr Literal ColumnRef Variable Error
  FunctionCall AggregateFunctionCall OrderedSetFunctionCall
  CastExpr CollateExpr CaseExpr
  IsExpr BetweenExpr LikeExpr InExpr
  SubqueryExpr ExistsExpr RaiseExpr RowValue
}

abstract Stmt {
  SelectStmt CompoundSelect ValuesClause WithClause
  InsertStmt UpdateStmt DeleteStmt
  CreateTableStmt CreateIndexStmt CreateViewStmt
  CreateTriggerStmt CreateVirtualTableStmt
  DropStmt AlterTableStmt
  TransactionStmt SavepointStmt
  PragmaStmt AnalyzeOrReindexStmt
  AttachStmt DetachStmt VacuumStmt
  ExplainStmt
}
