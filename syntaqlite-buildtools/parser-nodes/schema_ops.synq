enum DropObjectType { TABLE INDEX VIEW TRIGGER }
enum AlterOp { RENAME_TABLE RENAME_COLUMN DROP_COLUMN ADD_COLUMN }
enum TransactionType { DEFERRED IMMEDIATE EXCLUSIVE }
enum TransactionOp { BEGIN COMMIT ROLLBACK }
enum SavepointOp { SAVEPOINT RELEASE ROLLBACK_TO }

node QualifiedName {
  object_name: index Name
  schema: index Name

  fmt {
    if_set(schema) { child(schema) "." }
    child(object_name)
  }
}

node DropStmt {
  object_type: inline DropObjectType
  if_exists: inline Bool
  target: index QualifiedName

  fmt {
    "DROP" space
    enum_display(object_type, {
      TABLE="TABLE" INDEX="INDEX" VIEW="VIEW" TRIGGER="TRIGGER"
    })
    if_flag(if_exists) { space "IF" "EXISTS" }
    space child(target)
  }
}

node AlterTableStmt {
  op: inline AlterOp
  target: index QualifiedName
  new_name: index Name
  old_name: index Name

  semantic { alter_table(op: op, target: target, new_name: new_name, old_name: old_name) }

  fmt {
    "ALTER" "TABLE" space
    if_set(target) { child(target) space }
    switch(op) {
      RENAME_TABLE  { "RENAME" "TO" space child(new_name) }
      RENAME_COLUMN { "RENAME" "COLUMN" space child(old_name) space "TO" space child(new_name) }
      DROP_COLUMN   { "DROP" "COLUMN" space child(old_name) }
      ADD_COLUMN    { "ADD" "COLUMN" space child(old_name) }
    }
  }
}

node TransactionStmt {
  op: inline TransactionOp
  trans_type: inline TransactionType

  fmt {
    switch(op) {
      BEGIN {
        "BEGIN"
        if_enum(trans_type, IMMEDIATE) { space "IMMEDIATE" }
        if_enum(trans_type, EXCLUSIVE) { space "EXCLUSIVE" }
      }
      COMMIT   { "COMMIT" }
      ROLLBACK { "ROLLBACK" }
    }
  }
}

node SavepointStmt {
  op: inline SavepointOp
  savepoint_name: index Name

  fmt {
    switch(op) {
      SAVEPOINT   { "SAVEPOINT" space child(savepoint_name) }
      RELEASE     { "RELEASE" "SAVEPOINT" space child(savepoint_name) }
      ROLLBACK_TO { "ROLLBACK" "TO" "SAVEPOINT" space child(savepoint_name) }
    }
  }
}
