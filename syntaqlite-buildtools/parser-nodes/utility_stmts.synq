enum ExplainMode { EXPLAIN QUERY_PLAN }
enum PragmaForm { BARE EQ CALL }
enum AnalyzeOrReindexOp { ANALYZE REINDEX }

node PragmaStmt {
  pragma_name: inline SyntaqliteTextSpan
  schema: inline SyntaqliteTextSpan
  value: inline SyntaqliteTextSpan
  pragma_form: inline PragmaForm

  fmt {
    "PRAGMA" space
    if_span(schema) { span(schema) "." }
    span(pragma_name)
    switch(pragma_form) {
      EQ   { space "=" space span(value) }
      CALL { "(" span(value) ")" }
    }
  }
}

node AnalyzeOrReindexStmt {
  target_name: inline SyntaqliteTextSpan
  schema: inline SyntaqliteTextSpan
  kind: inline AnalyzeOrReindexOp

  fmt {
    if_enum(kind, REINDEX) { "REINDEX" } else { "ANALYZE" }
    if_span(schema) {
      space span(schema) "." span(target_name)
    } else {
      if_span(target_name) { space span(target_name) }
    }
  }
}

node AttachStmt {
  filename: index Expr
  db_name: index Expr
  key: index Expr

  fmt {
    "ATTACH" space child(filename) space "AS" space child(db_name)
    if_set(key) { space "KEY" space child(key) }
  }
}

node DetachStmt {
  db_name: index Expr

  fmt { "DETACH" space child(db_name) }
}

node VacuumStmt {
  schema: inline SyntaqliteTextSpan
  filename: index Expr

  fmt {
    "VACUUM"
    if_span(schema) { space span(schema) }
    if_set(filename) { space "INTO" space child(filename) }
  }
}

node ExplainStmt {
  explain_mode: inline ExplainMode
  stmt: index Stmt

  fmt {
    if_enum(explain_mode, QUERY_PLAN) { "EXPLAIN" "QUERY" "PLAN" } else { "EXPLAIN" }
    hardline child(stmt)
  }
}

node CreateIndexStmt {
  index_name: inline SyntaqliteTextSpan
  schema: inline SyntaqliteTextSpan
  table_name: inline SyntaqliteTextSpan
  is_unique: inline Bool
  if_not_exists: inline Bool
  columns: index OrderByList
  where_clause: index Expr

  fmt {
    group {
      "CREATE"
      if_flag(is_unique) { space "UNIQUE" }
      space "INDEX"
      if_flag(if_not_exists) { space "IF" "NOT" "EXISTS" }
      space
      if_span(schema) { span(schema) "." }
      span(index_name)
      space "ON" space span(table_name)
      group { space "(" nest { softline child(columns) } softline ")" }
      clause("WHERE", where_clause)
    }
  }
}

node CreateViewStmt {
  view_name: inline SyntaqliteTextSpan
  schema: inline SyntaqliteTextSpan
  is_temp: inline Bool
  if_not_exists: inline Bool
  column_names: index ExprList
  select: index Select

  semantic { define_view(name: view_name, select: select) }

  fmt {
    group {
      "CREATE"
      if_flag(is_temp) { space "TEMP" }
      space "VIEW"
      if_flag(if_not_exists) { space "IF" "NOT" "EXISTS" }
      space
      if_span(schema) { span(schema) "." }
      span(view_name)
      if_set(column_names) {
        "("
        nest {
          softline
          child(column_names)
        }
        softline ")"
      }
      line "AS"
    }
    hardline child(select)
  }
}
