# Regenerate syntaqlite-capi/include/syntaqlite.h, the single header that
# declares the whole libsyntaqlite C API, from the per-module headers.

set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"
exec cargo run -q -p syntaqlite-buildtools -- amalgamate \
  --syntax-dir syntaqlite-syntax \
  --lib-dir syntaqlite-capi \
  --output syntaqlite-capi/include/syntaqlite.h
