{
  "name": "syntaqlite",
  "version": "0.7.1",
  "description": "SQLite SQL parser, formatter, and validator for the browser — powered by WebAssembly",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/LalitMaganti/syntaqlite",
    "directory": "web/syntaqlite-js"
  },
  "homepage": "https://syntaqlite.com",
  "keywords": ["sqlite", "sql", "parser", "formatter", "wasm", "webassembly"],
  "type": "module",
  "files": ["dist", "wasm"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "prepublishOnly": "node scripts/verify-tarball.mjs",
    "test:node": "node tests/node-smoke.mjs",
    "test:package": "node tests/setup-fixture.mjs local && playwright test",
    "test:package:registry": "node tests/setup-fixture.mjs registry && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "typescript": "^5.7.2"
  }
}
